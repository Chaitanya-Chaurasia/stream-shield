{
  "manifest_version": 3,
  "name": "Stream Shield",
  "version": "1.0.0",
  "description": "Blocks pop-unders, click-hijacking overlays and ad redirects on the streaming sites you choose.",
  "permissions": ["scripting", "storage", "tabs", "webNavigation", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stream Shield",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "declarative_net_request": {
    "rule_resources": [{ "id": "adnets", "enabled": true, "path": "rules.json" }]
  }
}
